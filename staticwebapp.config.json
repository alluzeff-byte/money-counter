{
  "routes": [
    { "route": "/login", "rewrite": "/index.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/login" }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.auth/*"]
  },
  "globalHeaders": {
    "cache-control": "no-store"
  }
}
